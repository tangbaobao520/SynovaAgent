{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "bash scripts/hooks/hook-check-memory.sh",
            "statusMessage": "注入历史教训..."
          },
          {
            "type": "command",
            "command": "bash scripts/workflow/hook-block-write.sh"
          },
          {
            "type": "command",
            "command": "bash scripts/hooks/hook-enforce-v25.sh",
            "statusMessage": "验证 v2.5 合规..."
          }
        ]
      },
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "bash scripts/hooks/hook-git-detect.sh",
            "statusMessage": "识别 git 操作..."
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "bash scripts/workflow/verify-incremental.sh",
            "statusMessage": "验证改动..."
          }
        ]
      },
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "bash scripts/hooks/hook-git-detect.sh --post",
            "statusMessage": "关闭 git 操作窗口..."
          }
        ]
      }
    ]
  }
}
