# SynovaAgent 环境配置
# 复制此文件为 .env 并填入真实值:  cp .env.example .env

# ═══ LLM Provider (必填) ═══
LLM_API_KEY=sk-your-deepseek-api-key
LLM_BASE_URL=https://api.deepseek.com/v1
LLM_MODEL=deepseek-v4-flash

# ═══ 服务配置 ═══
PORT=3000
DEV_MODE=false
SYNOVA_DB_PATH=./data/synova.db

# ═══ API 认证 Token ═══
ENGINE_TOKENS=change-me-to-a-random-string

# ═══ 飞书连接器 (可选) ═══
FEISHU_APP_ID=
FEISHU_APP_SECRET=
FEISHU_WEBHOOK_URL=

# ═══ IMA 知识库 (可选) ═══
IMA_CLIENT_ID=
IMA_API_KEY=

# ═══ 安全 ═══
CREDENTIAL_MASTER_KEY=

# ═══ MCP 工具 (可选) ═══
# BRAVE_API_KEY=
# GITHUB_TOKEN=
# SYNOVA_SKIP_MCP=1
