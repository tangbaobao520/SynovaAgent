# SynovaAgent 环境配置
# 复制此文件为 .env 并填入真实值

# LLM Provider (必填)
LLM_API_KEY=sk-your-deepseek-api-key
LLM_BASE_URL=https://api.deepseek.com/v1
LLM_MODEL=deepseek-v4-flash

# 本地服务端口
PORT=3000
DEV_MODE=false

# API 认证 Token (生产环境必填, DEV_MODE=true 时跳过)
ENGINE_TOKENS=change-me-to-a-random-string

# 飞书连接器 (可选)
FEISHU_APP_ID=
FEISHU_APP_SECRET=

# 数据库路径
SYNOVA_DB_PATH=./data/synova.db

# CredentialVault 主密钥 (可选 — 不设则使用 ENGINE_TOKENS 派生)
CREDENTIAL_MASTER_KEY=
