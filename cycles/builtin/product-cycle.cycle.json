{
  "cycleId": "product-cycle",
  "name": "产品循环",
  "description": "研发→交付→迭代的产品闭环。研发投入决定交付质量，交付质量影响客户反馈，反馈驱动迭代方向。",
  "version": "1.0.0",
  "applicableIndustries": [],
  "nodes": [
    { "id": "rnd", "label": "研发投入", "type": "flow", "initialValue": 120, "unit": "万元/年", "edgeRefs": ["E-3.7"] },
    { "id": "delivery", "label": "交付质量", "type": "stock", "initialValue": 0.75, "unit": "评分", "edgeRefs": ["E-3.1"] },
    { "id": "feedback", "label": "客户反馈", "type": "flow", "initialValue": 0.4, "unit": "NPS", "edgeRefs": ["E-4.6"] },
    { "id": "iteration", "label": "迭代速度", "type": "parameter", "initialValue": 12, "unit": "天/周期", "edgeRefs": ["E-3.6"] }
  ],
  "edges": [
    { "from": "rnd", "to": "delivery", "polarity": "+", "delay": 2, "weight": 0.7 },
    { "from": "delivery", "to": "feedback", "polarity": "+", "delay": 1, "weight": 0.6 },
    { "from": "feedback", "to": "iteration", "polarity": "-", "delay": 0, "weight": 0.5 },
    { "from": "iteration", "to": "rnd", "polarity": "+", "delay": 1, "weight": 0.4 }
  ],
  "overflowFormula": {
    "condition": "delivery.currentValue < 0.4",
    "targetNode": "rnd",
    "formula": "rnd.initialValue * 1.2",
    "minDataMaturity": "high"
  },
  "dataMaturity": "high",
  "mapping": [
    { "nodeId": "rnd", "edgeId": "E-3.7", "weight": 0.8 },
    { "nodeId": "delivery", "edgeId": "E-3.1", "weight": 1.0 },
    { "nodeId": "feedback", "edgeId": "E-4.6", "weight": 0.9 },
    { "nodeId": "iteration", "edgeId": "E-3.6", "weight": 0.7 }
  ],
  "crossCyclePropagation": [
    { "targetCycleId": "cash-cycle", "viaEdge": "delivery→revenue", "strength": 0.6 }
  ]
}
