<!DOCTYPE html>
<html lang="{{lang}}">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>{{report.title}} — {{org_name}} (Executive Summary)</title>
<style>
  :root { --bg: #0d1117; --fg: #c9d1d9; --accent: #58a6ff; --green: #3fb950; --red: #f85149; --yellow: #d2991d; --border: #30363d; --card-bg: #161b22; }
  * { box-sizing: border-box; margin: 0; padding: 0; }
  body { background: var(--bg); color: var(--fg); font-family: -apple-system, BlinkMacSystemFont, sans-serif; font-size: 15px; line-height: 1.7; max-width: 700px; margin: 0 auto; padding: 40px 24px 80px; }
  h1 { font-size: 1.6rem; color: #f0f6fc; border-bottom: 2px solid var(--accent); padding-bottom: 12px; margin-bottom: 16px; }
  .score { font-size: 3rem; font-weight: 700; text-align: center; margin: 24px 0; }
  .card { background: var(--card-bg); border: 1px solid var(--border); border-radius: 8px; padding: 16px 20px; margin-bottom: 12px; }
  .card.critical { border-left: 3px solid var(--red); }
  .card.warning { border-left: 3px solid var(--yellow); }
  .tag { display: inline-block; padding: 2px 8px; border-radius: 10px; font-size: 0.78em; font-weight: 600; }
  .tag-p0 { background: rgba(248,81,73,0.18); color: var(--red); }
  .tag-p1 { background: rgba(210,153,29,0.18); color: var(--yellow); }
  .footer { margin-top: 48px; padding-top: 16px; border-top: 1px solid var(--border); color: #8b949e; font-size: 0.82em; text-align: center; }
</style>
</head>
<body>
<h1>{{report.title}}</h1>
<div class="meta"><p>{{report.generated_at}}: {{generated_at}}</p></div>

<div class="score">{{overall_score}}/100</div>

<h2>{{report.ceo_summary}}</h2>
<div class="card"><p>{{ceo_summary_text}}</p></div>

<h2>{{report.key_findings}}</h2>
{{#findings}}
<div class="card {{severity_class}}">
  <span class="tag tag-{{priority}}">{{priority}}</span>
  <strong>{{title}}</strong>
  <p>{{description}}</p>
</div>
{{/findings}}

{{#actions}}
<h2>{{report.action_recommendations}}</h2>
{{#items}}
<div class="card">
  <span class="tag tag-{{priority}}">{{priority}}</span>
  <strong>{{action}}</strong>
  <p style="font-size:0.85em; color:#8b949e;">{{timeline}}</p>
</div>
{{/items}}
{{/actions}}

<div class="footer"><p>{{report.footer}}</p></div>
</body>
</html>
