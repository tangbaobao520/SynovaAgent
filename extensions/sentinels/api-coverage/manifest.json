{
  "$schema": "https://synova.dev/schemas/sentinel-manifest-v1.json",
  "name": "api-coverage",
  "version": "1.0.0",
  "type": "sentinel",
  "displayName": "API\u53ef\u8fbe\u6027\u4e0e\u534f\u8bae\u8986\u76d6",
  "description": "T2: \u68c0\u6d4b\u4f01\u4e1aTOOL\u8282\u70b9\u7684API\u53ef\u8fbe\u7387\u4e0e\u6807\u51c6\u534f\u8bae\u8986\u76d6\u7387\u3002\u6570\u636e\u6e90: SOG TOOL\u8282\u70b9\u3002",
  "schedule": "0 9 * * *",
  "expert": "tech",
  "priority": "P1",
  "layer": "technology",
  "computeKind": "deterministic",
  "computes": [
    "api-availability",
    "protocol-coverage"
  ],
  "thresholds": {
    "api_availability": {
      "warning": 0.8,
      "critical": 0.6
    },
    "protocol_coverage": {
      "warning": 0.6,
      "critical": 0.3
    }
  },
  "aggregation": "worst_first",
  "context": {
    "requiredDataSources": [
      "sog_graph"
    ],
    "dataAccess": {
      "allowedDimensions": [
        "technology"
      ],
      "sensitiveAccess": "read"
    }
  },
  "entryPoint": "./aggregate.ts",
  "exportKey": "apiCoverageSentinel",
  "auxiliaryExperts": [
    "strategy"
  ]
}
