{
  "$schema": "https://synova.dev/schemas/sentinel-manifest-v1.json",
  "name": "gap-dynamics",
  "version": "1.0.0",
  "type": "sentinel",
  "displayName": "缝隙动力学 (Gap Dynamics)",
  "description": "D2: 分析组织协作图谱中的缝隙结构——未被覆盖的协作需求、信息孤岛、资源错配信号。",
  "schedule": "0 9 * * 1",
  "expert": "org",
  "priority": "P2",
  "layer": "capability",
  "computeKind": "graph",
  "computes": ["dynamics"],
  "thresholds": { "gap_intensity": { "warning": 0.4, "critical": 0.7 } },
  "aggregation": "worst_first",
  "context": {
    "requiredDataSources": ["sog_graph"],
    "dataAccess": { "allowedDimensions": ["collaboration"], "sensitiveAccess": "read" }
  },
  "entryPoint": "./computes/dynamics.ts",
  "exportKey": "gapDynamicsSentinel",
  "auxiliaryExperts": ["knowledge"]
}
