{
  "$schema": "https://synova.dev/schemas/sentinel-manifest-v1.json",
  "name": "growth-quality",
  "version": "1.0.0",
  "type": "sentinel",
  "displayName": "\u589e\u957f\u8d28\u91cf\u6307\u6570",
  "description": "F4: \u8bc4\u4f30\u589e\u957f\u8d28\u91cf\u2014\u2014\u73b0\u91d1\u6d41\u8f6c\u5316\u7387\u3001\u6709\u673a\u589e\u957f\u6bd4\u4f8b\u3001\u5e94\u6536\u8d26\u6b3e\u5065\u5eb7\u5ea6\u3002\u6570\u636e\u6e90: FINANCIAL, Client\u8282\u70b9\u3002",
  "schedule": "0 0 1 * *",
  "expert": "finance",
  "priority": "P1",
  "layer": "capital",
  "computeKind": "deterministic",
  "computes": [
    "cash-conversion-rate",
    "organic-growth-pct"
  ],
  "thresholds": {
    "cash_conversion": {
      "warning": 0.7,
      "critical": 0.5
    },
    "organic_growth": {
      "warning": 0.5,
      "critical": 0.3
    }
  },
  "aggregation": "worst_first",
  "context": {
    "requiredDataSources": [
      "sog_graph"
    ],
    "dataAccess": {
      "allowedDimensions": [
        "financial"
      ],
      "sensitiveAccess": "read"
    }
  },
  "entryPoint": "./aggregate.ts",
  "exportKey": "growthQualitySentinel",
  "auxiliaryExperts": [
    "strategy"
  ]
}
