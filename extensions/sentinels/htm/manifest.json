{
  "$schema": "https://synova.dev/schemas/sentinel-manifest-v1.json",
  "name": "htm",
  "version": "1.0.0",
  "type": "sentinel",
  "displayName": "混合信任模型 (HTM)",
  "description": "D3: 评估人+Agent 混合系统中信任水平的成熟度，从完全不信任(L0)到深度协作信任(L4)。",
  "schedule": "0 9 * * *",
  "expert": "org",
  "priority": "P2",
  "layer": "collaboration",
  "computeKind": "graph",
  "computes": ["trust"],
  "thresholds": {
    "trust_maturity": { "warning": 0.5, "critical": 0.3 }
  },
  "aggregation": "worst_first",
  "context": {
    "requiredDataSources": ["sog_graph"],
    "dataAccess": { "allowedDimensions": ["collaboration"], "sensitiveAccess": "read" }
  },
  "entryPoint": "./computes/trust.ts",
  "exportKey": "htmSentinel",
  "auxiliaryExperts": ["knowledge"]
}
