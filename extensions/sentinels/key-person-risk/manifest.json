{
  "$schema": "https://synova.dev/schemas/extension-manifest-v1.json",
  "name": "key-person-risk",
  "version": "1.0.0",
  "type": "sentinel",
  "displayName": "\u5173\u952e\u4eba\u98ce\u9669\u54e8\u5175",
  "description": "\u68c0\u6d4b\u7ec4\u7ec7\u4e2d\u72ec\u5360\u77e5\u8bc6\u57df\u7684\u5173\u952e\u4eba\u5458\u3002Bus Factor < 2 \u2192 \u9ad8\u98ce\u9669\u3002",
  "schedule": "0 3 * * *",
  "expert": "org",
  "priority": "P0",
  "computes": [
    "bus-factor"
  ],
  "thresholds": {
    "bus_factor": {
      "warning": 2,
      "critical": 1
    }
  },
  "aggregation": "worst_first",
  "context": {
    "requiredDataSources": [
      "sog_graph"
    ],
    "dataAccess": {
      "allowedDimensions": [
        "D3"
      ],
      "sensitiveAccess": "read"
    }
  },
  "entryPoint": "./aggregate.ts",
  "exportKey": "keyPersonRiskSentinel",
  "auxiliaryExperts": [
    "knowledge"
  ]
}
