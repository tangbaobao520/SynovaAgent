{
  "$schema": "https://synova.dev/schemas/sentinel-manifest-v1.json",
  "name": "key-person-risk",
  "version": "1.0.0",
  "type": "sentinel",
  "displayName": "关键人风险哨兵",
  "description": "检测组织中独占知识域的关键人员。Bus Factor < 2 → 高风险。",
  "schedule": "0 3 * * *",
  "expert": "org",
  "priority": "P0",
  "computes": [
    "bus-factor"
  ],
  "thresholds": {
    "bus_factor": {
      "warning": 2,
      "critical": 1
    },
    "decision_concentration": {
      "warning": 0.6,
      "critical": 0.8
    }
  },
  "aggregation": "worst_first",
  "context": {
    "requiredDataSources": [
      "sog_graph"
    ],
    "dataAccess": {
      "allowedDimensions": [
        "D3"
      ],
      "sensitiveAccess": "read"
    }
  },
  "entryPoint": "./aggregate.ts",
  "exportKey": "keyPersonRiskSentinel",
  "auxiliaryExperts": [
    "knowledge"
  ],
  "layer": "internal",
  "computeKind": "heuristic",
  "dependsOn": {
    "nodeTypes": [
      "Financial"
    ],
    "edgeTypes": [],
    "requiredFields": [
      "amount"
    ]
  },
  "id": "sentinel-key-person-risk"
}
