{
  "$schema": "https://synova.dev/schemas/extension-manifest-v1.json",
  "name": "sentinels",
  "version": "1.0.0",
  "type": "sentinel",
  "displayName": "哨兵系统",
  "description": "SynovaAgent 定时哨兵 — 三层粒度模型（专家→哨兵→计算）。哨兵 = 可独立告警的最小子领域。每哨兵含 N 个计算指标 + 1 个 aggregate。",
  "entryPoint": "../src/sentinel/sentinel-loader.ts",
  "exportKey": "loadSentinels",
  "model": {
    "tiers": {
      "expert": "领域 — 解读 N 个哨兵的 Finding",
      "sentinel": "子领域 — 综合 M 个指标，判断'这个子领域出问题没有'",
      "compute": "指标 — 纯数学，盯一个数"
    },
    "boundary_rule": "哨兵 = 可以独立说'这里出问题了'的最小子领域。不是整个领域（太粗），不是一个指标（太细）。"
  },
  "sentinels": {
    "finance": ["cost-health", "revenue-health", "cash-runway", "profit-health", "capital-efficiency", "financing-constraint", "capital-structure", "growth-quality", "capital-turnover", "unit-economics", "value-capture"],
    "org": ["key-person-risk", "internal-transaction-cost", "network-power"],
    "tech": ["api-coverage", "data-health", "software-health", "connector-coverage", "process-ai-readiness", "ai-ecosystem-fit", "agent-deployment-maturity", "ai-investment-return", "human-agent-boundary"],
    "marketing": ["customer-demand-shift"],
    "strategy": ["market-lifecycle", "opportunity-window", "competitive-dynamics", "environment-rent-dependency", "structural-change", "niche-breadth", "niche-squeeze", "competitive-moat-structural", "competitive-moat-perceptual", "moat-dependency"],
    "business_model": ["business-model-coherence", "time-penetration", "make-or-buy"]
  }
}
