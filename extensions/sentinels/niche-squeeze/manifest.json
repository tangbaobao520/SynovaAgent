{
  "$schema": "https://synova.dev/schemas/sentinel-manifest-v1.json",
  "name": "niche-squeeze",
  "version": "1.0.0",
  "type": "sentinel",
  "displayName": "\u751f\u6001\u4f4d\u6324\u538b\u6307\u6570",
  "description": "I2: \u8ba1\u7b97\u7ade\u4e89\u6324\u538b\u7a0b\u5ea6\u2014\u2014HHI\u96c6\u4e2d\u5ea6\u3001\u7ade\u4e89\u8005\u5bc6\u5ea6\u3001\u4ef7\u683c\u538b\u529b\u3002\u6570\u636e\u6e90: Market, Client, Supplier\u8282\u70b9\u3002",
