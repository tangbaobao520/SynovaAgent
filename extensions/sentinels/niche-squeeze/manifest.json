{
  "$schema": "https://synova.dev/schemas/sentinel-manifest-v1.json",
  "name": "niche-squeeze",
  "version": "1.0.0",
  "type": "sentinel",
  "displayName": "生态位挤压指数",
  "description": "I2: 计算竞争挤压程度——HHI集中度、竞争者密度、价格压力。数据源: Market, Client, Supplier节点。",
  "schedule": "0 0 1 * *",
  "expert": "strategy",
  "priority": "P1",
  "layer": "interface",
  "computeKind": "deterministic",
  "computes": [
    "niche-squeeze-index"
  ],
  "thresholds": {
    "squeeze_index": {
      "warning": 0.5,
      "critical": 0.7
    }
  },
  "aggregation": "worst_first",
  "context": {
    "requiredDataSources": [
      "sog_graph"
    ],
    "dataAccess": {
      "allowedDimensions": [
        "strategic"
      ],
      "sensitiveAccess": "read"
    }
  },
  "entryPoint": "./aggregate.ts",
  "exportKey": "nicheSqueezeSentinel",
  "auxiliaryExperts": [
    "marketing"
  ],
  "id": "sentinel-niche-squeeze"
}
