{
  "$schema": "https://synova.dev/schemas/sentinel-manifest-v1.json",
  "name": "path-dependency",
  "version": "1.0.0",
  "type": "sentinel",
  "displayName": "路径依赖 (Path Dependency)",
  "description": "D2: 检测组织对特定技术栈、流程或合作模式的依赖程度。高路径依赖 = 低切换灵活性 = 高锁定风险。",
  "schedule": "0 9 * * 1",
  "expert": "strategy",
  "priority": "P2",
  "layer": "capability",
  "computeKind": "graph",
  "computes": ["detect"],
  "thresholds": { "dependency_score": { "warning": 0.4, "critical": 0.7 } },
  "aggregation": "worst_first",
  "context": {
    "requiredDataSources": ["sog_graph"],
    "dataAccess": { "allowedDimensions": ["strategic"], "sensitiveAccess": "read" }
  },
  "entryPoint": "./computes/detect.ts",
  "exportKey": "pathDependencySentinel",
  "auxiliaryExperts": ["knowledge"]
}
