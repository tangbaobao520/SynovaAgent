{
  "$schema": "https://synova.dev/schemas/extension-manifest-v1.json",
  "name": "profit-health",
  "version": "1.0.0",
  "type": "sentinel",
  "displayName": "利润健康哨兵",
  "description": "监控利润率变化和行业对标。输出 Finding: '利润率下降 Xpp，与行业基准差距扩大。'",
  "schedule": "0 9 * * 1",
  "expert": "finance",
  "priority": "P1",
  "computes": ["profit-margin-change", "gross-margin-vs-benchmark"],
  "thresholds": {
    "profit_margin_change": { "warning": -0.02, "critical": -0.05 },
    "margin_vs_benchmark": { "warning": -0.05, "critical": -0.15 }
  },
  "aggregation": "worst_first",
  "context": {
    "requiredDataSources": ["sog_graph", "financial_baseline"],
    "dataAccess": { "allowedDimensions": ["financial"], "sensitiveAccess": "read" }
  },
  "entryPoint": "./aggregate.ts",
  "exportKey": "profitHealthSentinel"
}
