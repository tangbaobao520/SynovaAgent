{
  "$schema": "https://synova.dev/schemas/extension-manifest-v1.json",
  "name": "profit-health",
  "version": "1.0.0",
  "type": "sentinel",
  "displayName": "\u5229\u6da6\u5065\u5eb7\u54e8\u5175",
  "description": "\u76d1\u63a7\u5229\u6da6\u7387\u53d8\u5316\u8d8b\u52bf\u4e0e\u884c\u4e1a\u57fa\u51c6\u5bf9\u6bd4\u3002\u8f93\u51fa Finding: '\u5229\u6da6\u7387\u4e0b\u964d X%\uff0c\u843d\u540e\u884c\u4e1a\u57fa\u51c6 Y%\u3002'",
  "schedule": "0 9 * * 1",
  "expert": "finance",
  "priority": "P1",
  "computes": [
    "profit-margin-change",
    "margin-vs-benchmark"
  ],
  "thresholds": {
    "profit_margin_change": {
      "warning": -0.02,
      "critical": -0.05
    },
    "margin_vs_benchmark": {
      "warning": -0.05,
      "critical": -0.15
    }
  },
  "aggregation": "worst_first",
  "context": {
    "requiredDataSources": [
      "sog_graph",
      "financial_baseline"
    ],
    "dataAccess": {
      "allowedDimensions": [
        "financial"
      ],
      "sensitiveAccess": "read"
    }
  },
  "entryPoint": "./aggregate.ts",
  "exportKey": "profitHealthSentinel",
  "auxiliaryExperts": [
    "strategy"
  ]
}
