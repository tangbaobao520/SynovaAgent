{
  "$schema": "https://synova.dev/schemas/sentinel-manifest-v1.json",
  "name": "seven-powers",
  "version": "1.0.0",
  "type": "sentinel",
  "displayName": "7Powers 竞争壁垒评估",
  "description": "D6: 基于 Hamilton Helmer 的 7 Powers 框架评估企业竞争壁垒强度——规模经济、网络效应、反向定位、转换成本、品牌、流程优势、资源垄断。",
  "schedule": "0 0 1 * *",
  "expert": "strategy",
  "priority": "P1",
  "layer": "strategic",
  "computeKind": "graph",
  "computes": ["score"],
  "thresholds": { "moat_strength": { "warning": 0.4, "critical": 0.2 } },
  "aggregation": "average",
  "context": {
    "requiredDataSources": ["sog_graph"],
    "dataAccess": { "allowedDimensions": ["strategic", "financial"], "sensitiveAccess": "read" }
  },
  "entryPoint": "./computes/score.ts",
  "exportKey": "sevenPowersSentinel",
  "auxiliaryExperts": ["knowledge"]
}
