{
  "$schema": "https://synova.dev/schemas/sentinel-manifest-v1.json",
  "name": "software-health",
  "version": "1.0.0",
  "type": "sentinel",
  "displayName": "\u8f6f\u4ef6\u8d44\u4ea7\u5065\u5eb7\u5ea6",
  "description": "T1: \u8bc4\u4f30\u4f01\u4e1a\u8f6f\u4ef6\u8d44\u4ea7\u7684\u5229\u7528\u7387\u4e0e\u6388\u6743\u5408\u89c4\u6027\u3002\u6570\u636e\u6e90: SOG TOOL/APP \u8282\u70b9\u3002",
  "schedule": "0 10 * * 1",
  "expert": "tech",
  "priority": "P1",
  "layer": "technology",
  "computeKind": "deterministic",
  "computes": [
    "saas-usage-score",
    "shadow-it-score"
  ],
  "thresholds": {
    "usage_rate": {
      "warning": 0.4,
      "critical": 0.2
    },
    "unauthorized_rate": {
      "warning": 0.3,
      "critical": 0.5
    }
  },
  "aggregation": "worst_first",
  "context": {
    "requiredDataSources": [
      "sog_graph"
    ],
    "dataAccess": {
      "allowedDimensions": [
        "technology"
      ],
      "sensitiveAccess": "read"
    }
  },
  "entryPoint": "./aggregate.ts",
  "exportKey": "softwareHealthSentinel",
  "auxiliaryExperts": [
    "strategy"
  ]
}
