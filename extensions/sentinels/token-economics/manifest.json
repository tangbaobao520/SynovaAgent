{
  "$schema": "https://synova.dev/schemas/sentinel-manifest-v1.json",
  "name": "token-economics",
  "version": "1.0.0",
  "type": "sentinel",
  "displayName": "单位经济学 (Token Economics)",
  "description": "D1: 分析单位经济的健康度——客户获取成本(CAC)、生命周期价值(LTV)、LTV/CAC 比率、毛利率、回本周期。",
  "schedule": "0 9 * * 1",
  "expert": "finance",
  "priority": "P1",
  "layer": "financial",
  "computeKind": "graph",
  "computes": ["cost"],
  "thresholds": { "unit_health": { "warning": 0.4, "critical": 0.2 } },
  "aggregation": "worst_first",
  "context": {
    "requiredDataSources": ["sog_graph"],
    "dataAccess": { "allowedDimensions": ["financial"], "sensitiveAccess": "read" }
  },
  "entryPoint": "./computes/cost.ts",
  "exportKey": "tokenEconomicsSentinel",
  "auxiliaryExperts": ["knowledge"]
}
