{
  "name": "check-data-source-health",
  "version": "1.0.0",
  "type": "skill",
  "displayName": "数据源健康检查",
  "description": "检查所有数据源的健康状态，包括连接状态、数据新鲜度、延迟和错误率。",
  "tier": "L7",
  "complexity": "atomic",
  "expert": "host",
  "tools": [
    "query-graph",
    "acquire-edge-data"
  ],
  "entryPoint": "./SKILL.md",
  "exportKey": "default",
  "permissions": {
    "dataAccess": {
      "dimensions": [
        "system"
      ],
      "sensitiveAccess": "none"
    },
    "crossExpert": []
  },
  "dependencies": {
    "skills": [],
    "edges": [
      "E-1.5",
      "E-0.1",
      "E-0.2"
    ],
    "computes": [],
    "sentinels": []
  },
  "boundaries": {
    "prohibitedDimensions": [
      "customer-data",
      "financial-decision"
    ],
    "degradedBehavior": "系统数据不可用时返回 degraded:true",
    "preconditions": [
      "下级Skill执行结果已就绪",
      "GraphStore连接正常"
    ]
  },
  "loading": "on-demand",
  "lifecycle": "active"
}
