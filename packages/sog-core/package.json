{
  "name": "@synova/sog-core",
  "version": "1.0.0",
  "description": "Synova Ontology Graph (SOG) Core Schema — 14 node types + 10 edge types, frozen/immutable",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    },
    "./sog-core-schema": {
      "import": "./dist/sog-core-schema.js",
      "types": "./dist/sog-core-schema.d.ts"
    }
  },
  "files": [
    "dist/",
    "README.md"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "vitest run",
    "prepublishOnly": "npm run build"
  },
  "keywords": ["synova", "sog", "ontology", "organization-graph", "diagnosis"],
  "license": "UNLICENSED",
  "private": true
}
